# Line endings: LF in the repository and in every checkout (Windows included), so editors that
# write LF (Obsidian, VS Code) never leave files that only differ by their line endings.
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.hex binary
*.bin binary
